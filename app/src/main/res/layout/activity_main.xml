<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/ink" android:textColor="@color/paper"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        android:textSize="18sp" android:text="@string/app_name" />

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />

    <RadioGroup android:id="@+id/tabs" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/profile" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="48dp" android:text="@string/profile_title" />
        <RadioButton android:id="@+id/two_cards" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="48dp" android:text="@string/two_cards" />
        <RadioButton android:id="@+id/three_cards" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="48dp" android:text="@string/three_cards" />
    </RadioGroup>
</LinearLayout>
